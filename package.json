{
  "name": "@chenyfan/nasdk",
  "version": "1.0.4",
  "description": "Nyirusu Application SDK, a general-purpose transport and dispatch framework",
  "author": "CyanFalse",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./NApp": {
      "types": "./dist/NApp/index.d.ts",
      "import": "./dist/NApp/index.js"
    },
    "./NACP": {
      "types": "./dist/NACP/index.d.ts",
      "import": "./dist/NACP/index.js"
    },
    "./NACT": {
      "types": "./dist/NACT/index.d.ts",
      "import": "./dist/NACT/index.js"
    },
    "./NACEB": {
      "types": "./dist/NACEB/index.d.ts",
      "import": "./dist/NACEB/index.js"
    },
    "./NACAB": {
      "types": "./dist/NACAB/index.d.ts",
      "import": "./dist/NACAB/index.js"
    },
    "./EventBus": {
      "types": "./dist/EventBus.d.ts",
      "import": "./dist/EventBus.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/workspaces.mjs build",
    "typecheck": "bun scripts/workspaces.mjs typecheck",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun run test:simple && bun run test:full && bun run test:edge",
    "test:simple": "bun test ./test/simple/*.test.mjs --timeout 30000",
    "test:full": "bun test ./test/full/*.test.mjs --timeout 30000",
    "test:edge": "bun test ./test/edge/*.test.mjs --timeout 30000",
    "docs:dev": "bun --bun vitepress dev docs",
    "docs:build": "bun --bun vitepress build docs",
    "docs:preview": "bun --bun vitepress preview docs",
    "test:edge:slow": "NASDK_SLOW=1 bun test ./test/edge/*.test.mjs --timeout 180000",
    "test:framework": "bun scripts/test-frameworks.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cbor-x": "^1.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mermaid": "10.9.5",
    "tsx": "4.20.5",
    "typescript": "^5.9.0",
    "vitepress": "1.6.4",
    "h3": "^1.15.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "rpc",
    "transport",
    "event-driven",
    "task-scheduler",
    "websocket",
    "cbor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenYFan/NASDK.git"
  },
  "packageManager": "bun@1.4.2"
}
