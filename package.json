{
  "name": "@chenyfan/nasdk",
  "version": "0.1.0",
  "description": "Nyirusu Application SDK,a general-purpose transport and dispatch framework",
  "author": "CyanFalse",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./NApp": {
      "types": "./dist/NApp/index.d.ts",
      "import": "./dist/NApp/index.js"
    },
    "./NACP": {
      "types": "./dist/NACP/index.d.ts",
      "import": "./dist/NACP/index.js"
    },
    "./NACT": {
      "types": "./dist/NACT/index.d.ts",
      "import": "./dist/NACT/index.js"
    },
    "./NACEB": {
      "types": "./dist/NACEB/index.d.ts",
      "import": "./dist/NACEB/index.js"
    },
    "./NACAB": {
      "types": "./dist/NACAB/index.d.ts",
      "import": "./dist/NACAB/index.js"
    },
    "./EventBus": {
      "types": "./dist/EventBus.d.ts",
      "import": "./dist/EventBus.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --test \"test/*/*.test.mjs\"",
    "test:simple": "node --experimental-strip-types --test \"test/simple/*.test.mjs\"",
    "test:full": "node --experimental-strip-types --test \"test/full/*.test.mjs\"",
    "test:edge": "node --experimental-strip-types --test \"test/edge/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cbor-x": "^1.6.4",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "rpc",
    "transport",
    "event-driven",
    "task-scheduler",
    "websocket",
    "cbor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenYFan/NASDK.git"
  }
}
